{
  "name": "cynosure",
  "version": "0.2.0",
  "description": "Jev-based adaptive model routing with structured decisions, persistent feedback, and hybrid retrieval",
  "license": "Apache-2.0",
  "author": "MobAI Inc.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "integrations/pi",
    "scripts/pi.mjs",
    "config/router.example.json",
    "config/task.example.json",
    "config/feedback.example.json",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "eval/README.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:docs": "node scripts/check-docs.mjs",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "eval:prepare": "python3 scripts/eval/prepare.py",
    "eval:run": "node scripts/eval/run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^24.13.6",
    "promptfoo": "0.123.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "sqlite-vec": "0.1.9"
  },
  "bin": {
    "cynosure": "./dist/cli.js"
  }
}
